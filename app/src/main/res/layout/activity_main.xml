<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#020505">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp"
        android:paddingTop="48dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="INDEX PRESCRIPT DEVICE"
            android:textColor="#4be8ff"
            android:textSize="18sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="12dp" />

        <ImageView
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:src="@drawable/icdeviceicon"
            android:layout_marginBottom="24dp" />

        <Switch
            android:id="@+id/switchEnabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Prescripts Active"
            android:textColor="#4be8ff"
            android:fontFamily="monospace"
            android:layout_marginBottom="32dp" />

        <TextView
            android:id="@+id/tvPermissionsMissing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠ Permissions Missing"
            android:textColor="#ff3b5c"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:visibility="gone"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/tvPermissionsMissing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠ Permissions Missing"
            android:textColor="#ff3b5c"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:visibility="gone"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvNoAppsWatched"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠ No Apps Watched"
            android:textColor="#ff3b5c"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:visibility="gone"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CORE"
            android:textColor="#5c6975"
            android:textSize="10sp"
            android:letterSpacing="0.1"
            android:fontFamily="monospace"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnOpenReminders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reminders"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnOpenConfigurations"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Configurations"
            android:layout_marginBottom="28dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="INSIGHTS"
            android:textColor="#5c6975"
            android:textSize="10sp"
            android:letterSpacing="0.1"
            android:fontFamily="monospace"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnViewLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="View Prescript Log"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnWeeklySummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Stats"
            android:layout_marginBottom="28dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SETUP"
            android:textColor="#5c6975"
            android:textSize="10sp"
            android:letterSpacing="0.1"
            android:fontFamily="monospace"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnOpenSetup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Setup and Testing" />

    </LinearLayout>

</ScrollView>