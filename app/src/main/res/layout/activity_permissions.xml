<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="top|center_horizontal"
    android:fitsSystemWindows="true"
    android:padding="24dp"
    android:background="#020505">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PERMISSIONS"
        android:textColor="#4be8ff"
        android:textSize="16sp"
        android:fontFamily="monospace"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btnNotifAccess"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Grant Notification Access"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnOverlayPermission"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Grant Overlay Permission"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnCalendarAccess"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Grant Calendar Access" />

    <Button
        android:id="@+id/btnBatteryOptimization"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Disable Battery Restriction"
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/btnAutostart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enable Autostart (Xiaomi/MIUI)"
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/btnUsageAccess"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Grant Usage Access (for Do Not Disturb Apps)"
        android:layout_marginTop="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Not on a Xiaomi phone? The Autostart button opens your app\'s general settings instead - look for &quot;Auto-launch&quot;, &quot;Protected apps&quot;, or similar sections, depending on your phone\'s brand. (Or simply search how to enable Autostart in X phone brand)"
        android:textColor="#8fa3ad"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:layout_marginTop="12dp" />

</LinearLayout>