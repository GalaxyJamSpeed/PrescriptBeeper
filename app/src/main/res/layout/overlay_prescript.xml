<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:background="#99000000">

    <FrameLayout
        android:layout_width="300dp"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_prescript_outer_glow"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="INDEX PRESCRIPT DEVICE"
                android:textColor="#3d4a56"
                android:textStyle="bold"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:id="@+id/senderInfoRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:visibility="gone"
                android:layout_marginBottom="10dp">

                <ImageView
                    android:id="@+id/ivSenderIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/tvSenderInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#3d4a56"
                    android:textSize="10sp"
                    android:fontFamily="monospace" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_prescript_border"
                android:padding="20dp"
                android:gravity="center">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/indexicon"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/tvPrescript"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="_..........._"
                    android:textColor="#4be8ff"
                    android:textSize="16sp"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:layout_marginBottom="8dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

                <Button
                    android:id="@+id/btnAccept"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="ACCEPT"
                    android:backgroundTint="#35d7f0"
                    android:textColor="#0a1c22" />

                <Button
                    android:id="@+id/btnDismiss"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="DISMISS"
                    android:backgroundTint="#c7ced4"
                    android:textColor="#2f3b46" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="14dp">

                <TextView
                    android:id="@+id/tvFooterCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 prescripts completed"
                    android:textColor="#5c6975"
                    android:textSize="9sp"
                    android:fontFamily="monospace" />

                <ImageView
                    android:id="@+id/ivCompletedIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/tvStageLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="- Stage 1"
                    android:textColor="#5c6975"
                    android:textSize="9sp"
                    android:fontFamily="monospace" />

                <ImageView
                    android:id="@+id/ivStageIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="6dp" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvStageProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#5c6975"
                android:textSize="8sp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:layout_marginTop="2dp" />

            <LinearLayout
                android:id="@+id/karmicRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/ivKarmicIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/tvKarmicCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#ff3b5c"
                    android:textSize="9sp"
                    android:fontFamily="monospace"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/tvKarmicLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="- KARMIC CONSEQUENCE"
                    android:textColor="#ff3b5c"
                    android:textSize="9sp"
                    android:fontFamily="monospace" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/tvCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="10dp"
            android:text="5s"
            android:textColor="#3d4a56"
            android:textStyle="bold"
            android:textSize="11sp"
            android:fontFamily="monospace" />

    </FrameLayout>

</LinearLayout>